# =============================================================================
# Copia questo file in ".env" e modifica i valori che ti servono.
# Tutte le variabili del progetto hanno il prefisso PMC_ (vedi src/pmcopilot/config.py,
# dove ogni impostazione è commentata). Il file .env NON va mai su Git (.gitignore).
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
# dev = sviluppo in locale. prod = l'API si rifiuta di partire con la password
# di default (a meno di PMC_ALLOW_DEFAULT_PASSWORD=true) e i cookie sono "Secure".
PMC_ENV=dev

# --- Accesso alla console e all'API -----------------------------------------
# Utente amministratore: tutto (approvazioni, Esperimenti, Monitoraggio).
PMC_ADMIN_USER=admin
PMC_ADMIN_PASSWORD=admin
# Utente operatore (facoltativo): chatta e consulta, ma NON approva azioni.
# PMC_OPERATOR_USER=operatore
# PMC_OPERATOR_PASSWORD=cambiami
# Chiave che firma i cookie di sessione. Se manca viene generata e salvata in
# data/processed/.session_secret. Cambiarla disconnette tutti.
# PMC_SESSION_SECRET=
PMC_SESSION_HOURS=12
# Limiti per utente: richieste di chat al minuto e token al giorno (0 = illimitato)
PMC_RATE_LIMIT_PER_MINUTE=20
PMC_DAILY_TOKEN_BUDGET=2000000

# --- LLM ---------------------------------------------------------------------
# Provider: ollama (locale) | openai | anthropic
PMC_LLM_PROVIDER=ollama
PMC_OLLAMA_BASE_URL=http://localhost:11434
# Modello di chat: deve supportare il tool calling. Alternative locali: llama3.1:8b, mistral-nemo
PMC_LLM_MODEL=qwen3:8b
# Finestra di contesto chiesta a Ollama (token). Con le API cloud conta quella del modello.
PMC_LLM_NUM_CTX=8192
# qwen3 è un modello "thinking": false = niente ragionamento esteso, risposte più rapide.
PMC_LLM_REASONING=false
PMC_LLM_MAX_OUTPUT_TOKENS=1024
PMC_LLM_TIMEOUT_S=120
PMC_LLM_MAX_RETRIES=2
# Modello di riserva se il principale fallisce, "provider:modello" (es. ollama:llama3.1:8b)
# PMC_LLM_FALLBACK=
# Prezzi per milione di token, per stimare i costi in console e nelle valutazioni
PMC_LLM_PRICE_IN_PER_MTOK=0
PMC_LLM_PRICE_OUT_PER_MTOK=0
# Modello giudice per la valutazione, "provider:modello" (vuoto = lo stesso dell'agente).
# Meglio uno più forte del modello valutato, es. openai:gpt-4o-mini o ollama:qwen3:14b
# PMC_JUDGE_MODEL=

# --- Esempio: API cloud al posto di Ollama ------------------------------------
# pip install -e ".[cloud]"   (già incluso in make install)
# PMC_LLM_PROVIDER=openai
# PMC_LLM_MODEL=gpt-4o-mini
# PMC_LLM_PRICE_IN_PER_MTOK=0.15
# PMC_LLM_PRICE_OUT_PER_MTOK=0.60
# OPENAI_API_KEY=sk-...
#
# PMC_LLM_PROVIDER=anthropic
# PMC_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Embedding e RAG ------------------------------------------------------------
# ollama | openai | fake (fake = vettori finti, solo per test e CI)
PMC_EMBEDDING_PROVIDER=ollama
PMC_EMBEDDING_MODEL=nomic-embed-text
# dense = solo embedding | bm25 = solo parole chiave | hybrid = entrambi, fusi con RRF
PMC_RETRIEVER_MODE=hybrid
PMC_RETRIEVER_K=4
PMC_CHUNK_SIZE=900
PMC_CHUNK_OVERLAP=120

# --- Agente --------------------------------------------------------------------
PMC_ROUTER_ENABLED=true
# off = solo regole | llm = anche un classificatore LLM contro le prompt injection
PMC_INJECTION_CLASSIFIER=off
PMC_MAX_MODEL_CALLS=8
PMC_MAX_TOOL_CALLS=10
PMC_MAX_TOKENS_PER_REQUEST=60000
# Oltre questa frazione della finestra di contesto la storia viene riassunta
PMC_SUMMARIZE_AT_FRACTION=0.7
# sqlite = le conversazioni sopravvivono ai riavvii | memory = solo in RAM
PMC_CHECKPOINTER=sqlite

# --- Dati ------------------------------------------------------------------------
# true = non scaricare AI4I 2020 da UCI e usare il generatore sintetico
PMC_FORCE_SYNTHETIC_DATA=false

# --- Observability --------------------------------------------------------------
PMC_LOG_LEVEL=INFO
PMC_LOG_TO_FILE=true
PMC_LOG_MAX_MB=20
PMC_LOG_BACKUPS=5
PMC_TRACE_TO_FILE=true
# Oscura email, telefoni, codici fiscali e IBAN in log e trace
PMC_REDACT_PII=true
# Langfuse self-hosted: "make langfuse-up" imposta da solo le righe qui sotto
PMC_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# --- Alert -----------------------------------------------------------------------
# Webhook Slack/Teams che riceve gli alert nuovi (vuoto = solo console e log)
# PMC_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
PMC_ALERT_ERROR_RATE=0.05
PMC_ALERT_P95_LATENCY_S=60
PMC_ALERT_WINDOW_MIN=15

# --- Lavori periodici (scheduler dentro l'API) ------------------------------------
PMC_SCHEDULER_ENABLED=true
PMC_SCORING_INTERVAL_MIN=60
PMC_DRIFT_INTERVAL_MIN=60
PMC_DRIFT_WINDOW_HOURS=24
PMC_DRIFT_PSI_WARN=0.1
PMC_DRIFT_PSI_ALERT=0.25
PMC_BACKUP_INTERVAL_HOURS=24
PMC_BACKUPS_KEEP=7
